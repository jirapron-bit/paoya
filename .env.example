# คัดลอกไฟล์นี้เป็นชื่อ .env แล้วแก้ค่าตามต้องการ
# ห้ามอัปโหลดไฟล์ .env ขึ้น GitHub (มี .gitignore กันไว้แล้ว)
# ตอน deploy ให้ใส่ค่าเหล่านี้ในหน้า "Environment Variables" ของโฮสต์แทนการอัปโหลดไฟล์

PORT=3000

# ===== จำเป็น =====
# ข้อความสุ่มยาว ๆ ใช้เซ็นโทเคนเข้าสู่ระบบ (production ต้องยาวอย่างน้อย 32 ตัว)
# สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ถ้าเปลี่ยนค่านี้ ผู้ใช้ทุกคนจะถูกออกจากระบบ
JWT_SECRET=change-me-to-a-long-random-string

# ตั้งเป็น production ตอนใช้งานจริง (cookie จะส่งผ่าน https เท่านั้น และไม่แสดงลิงก์รีเซ็ตรหัสผ่านบนหน้าเว็บ)
# NODE_ENV=production

# ===== ตอน deploy =====
# รันหลัง proxy/โฮสต์ (Render, Railway, Fly.io, Nginx, Cloudflare) ให้ตั้งเป็น 1
# TRUST_PROXY=1

# ที่อยู่เว็บจริง ใช้สร้างลิงก์ในอีเมลรีเซ็ตรหัสผ่าน
# APP_URL=https://paoya.example.com

# ที่เก็บไฟล์ฐานข้อมูล ต้องอยู่บนดิสก์ถาวร (volume) ของโฮสต์ ไม่งั้นข้อมูลหายตอน deploy ใหม่
# DB_FILE=/data/paoya.db

# ===== ส่งอีเมลรีเซ็ตรหัสผ่าน (แนะนำ) =====
# สมัครฟรีที่ https://resend.com แล้วยืนยันโดเมนของคุณ
# RESEND_API_KEY=
# EMAIL_FROM=เป๋ายา <no-reply@your-domain.com>

# ===== AI: แชทเภสัชกร + สแกนยา (ไม่บังคับ เลือกอย่างใดอย่างหนึ่ง) =====
# ทาง 1 (แนะนำ ฟรี ไม่ต้องผูกบัตร): Groq  สมัครที่ https://console.groq.com/keys
GROQ_API_KEY=
# ทาง 2: Google Gemini  https://aistudio.google.com/apikey (บางบัญชีต้องเปิด billing)
GEMINI_API_KEY=
# ทาง 3: บริการอื่นที่ใช้รูปแบบ OpenAI (OpenRouter, GitHub Models, OpenAI)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=
#
# ถ้าใส่ไว้หลายอัน เลือกเองได้: AI_PROVIDER=groq | gemini | openai
# เปลี่ยนรุ่นโมเดล (ต้องเป็นรุ่นที่รับรูปภาพได้ ถ้าจะใช้สแกน): AI_MODEL=qwen/qwen3.8-27b
# GEMINI_MODEL=gemini-flash-latest
# ตรวจว่า key ใช้ได้ไหม: npm run check-ai

# ===== ปรับแต่ง (ไม่บังคับ) =====
# SESSION_DAYS=7          # อยู่ในระบบได้กี่วันก่อนต้องเข้าสู่ระบบใหม่
# API_RATE_LIMIT=300      # จำนวนคำขอ API สูงสุดต่อ IP ต่อนาที
# AI_CHAT_LIMIT=30        # ถาม AI ได้กี่ครั้งต่อผู้ใช้ ต่อ 10 นาที
# AI_SCAN_LIMIT=20        # สแกนด้วย AI ได้กี่ครั้งต่อผู้ใช้ ต่อ 10 นาที
# COOKIE_SECURE=true      # บังคับ/ปิด cookie แบบ https (ค่าเริ่มต้น: เปิดเมื่อ NODE_ENV=production)
# CORS_ORIGIN=https://other-frontend.example.com   # เฉพาะกรณีหน้าเว็บอยู่คนละโดเมน (ไม่แนะนำ)
